{
  "name": "medos-backend",
  "version": "2.0.0",
  "description": "MedOS Hospital Management System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node src/index.js",
    "dev": "nodemon server.js",
