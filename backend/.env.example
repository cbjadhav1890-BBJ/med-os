# MedOS HMS - Environment Configuration
# Copy this file to .env and update values for your environment

# Server Configuration
NODE_ENV=development
PORT=3001

# Database - PostgreSQL (required for production)
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://postgres:password@localhost:5432/medos

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-characters
JWT_EXPIRY=10h

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# AI Configuration (Optional - for Claude Haiku SOAP notes)
ANTHROPIC_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Session Configuration
SESSION_SECRET=change-this-session-secret